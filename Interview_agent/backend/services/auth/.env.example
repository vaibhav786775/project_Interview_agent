# Auth Service Environment Variables
PORT=6001
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/auth_service?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Note: Also requires serviceAccountKey.json placed in this directory (Interview_agent/backend/services/auth/)
# Obtain serviceAccountKey.json from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
